MTECH_APP_NAME=MTech Personal AI
MTECH_APP_VERSION=0.1.0
MTECH_ENVIRONMENT=development

# Optional: without a key the API keeps returning its development placeholder.
# Create a key in your OpenRouter account before enabling provider requests.
MTECH_OPENROUTER_API_KEY=
MTECH_OPENROUTER_MODEL=openrouter/free
MTECH_OPENROUTER_TIMEOUT_SECONDS=35
